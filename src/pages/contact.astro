---
import Layout from '../layouts/Layout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.evstartups.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Contact & Editorial Corrections',
      item: 'https://www.evstartups.com/contact',
    },
  ],
};
---

<Layout
  title="Contact the Editorial Team | evStartups.com"
  description="Contact the evStartups editorial team to update your company profile, request corrections, or submit an enterprise EV software platform for review."
  jsonLd={breadcrumbSchema}
>
  <div class="bg-slate-50 min-h-screen pb-20">
    <header class="border-b border-slate-200/80 bg-white py-14 sm:py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-4">
          <a href="/" class="hover:text-slate-900 transition">Home</a>
          <span>/</span>
          <span class="text-slate-900 font-semibold">Contact</span>
        </nav>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl font-['Plus_Jakarta_Sans']">
          Editorial Inquiries & Profile Updates
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          Are you a representative of a featured EV fleet software provider, or would you like to submit your platform for inclusion in our B2B directory?
        </p>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        <!-- Direct Contact Cards -->
        <div class="md:col-span-2 rounded-2xl border border-slate-200 bg-white p-8 shadow-xs space-y-6">
          <h2 class="text-xl font-bold text-slate-900 font-['Plus_Jakarta_Sans']">
            Submit a Profile Correction or Update
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            We maintain an objective, independent directory of commercial electric vehicle software providers. To ensure accuracy for fleet managers, we verify technical protocols (OCPP 1.6J/2.0.1), telematics compatibility, and deployment specializations.
          </p>

          <div class="rounded-xl border border-emerald-100 bg-emerald-50/60 p-5 space-y-2">
            <h3 class="text-sm font-bold text-emerald-950">
              Direct Editorial Desk
            </h3>
            <p class="text-xs text-emerald-800 leading-relaxed">
              Email our editorial team directly with your company name, official corporate domain, and the specific data points to verify.
            </p>
            <div class="pt-2">
              <a
                href="mailto:editorial@evstartups.com?subject=Profile%20Update%20Request&body=Company%20Name:%0AOfficial%20Corporate%20Email:%0ARequested%20Updates%20or%20Corrections:%0A"
                class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-bold text-white hover:bg-emerald-700 transition"
              >
                editorial@evstartups.com &rarr;
              </a>
            </div>
          </div>

          <div class="border-t border-slate-100 pt-6 space-y-4">
            <h3 class="text-sm font-bold text-slate-900">
              What We Need for Profile Updates:
            </h3>
            <ul class="space-y-2 text-xs text-slate-600">
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Verification from an official corporate email domain matching the software entity.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Documentation of supported protocols (e.g. OCPP 1.6J, OCPP 2.0.1, ISO 15118, OpenADR).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Verified hardware interoperability lists and telematics partner integrations.</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Sidebar Info -->
        <div class="space-y-6">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
              Independent Directory
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              evStartups.com does not accept paid placements to alter editorial evaluations, pros, or operational considerations.
            </p>
          </div>

          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">
              Quick Links
            </h3>
            <ul class="space-y-2 text-xs text-slate-600">
              <li>
                <a href="/companies" class="text-emerald-600 hover:underline">Browse All Companies &rarr;</a>
              </li>
              <li>
                <a href="/categories" class="text-emerald-600 hover:underline">Explore Software Categories &rarr;</a>
              </li>
              <li>
                <a href="/alternatives" class="text-emerald-600 hover:underline">Head-to-Head Comparisons &rarr;</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
