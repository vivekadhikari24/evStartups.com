---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getCompanyDomain, getCompanyLogoUrl } from '../../utils/companyMeta';

const alternatives = await getCollection('alternatives');

const alternativesWithCompanies = await Promise.all(
  alternatives.map(async (alt) => {
    const companies = await Promise.all(alt.data.related_companies.map((ref) => getEntry(ref)));
    const valid = companies.filter(Boolean).map((c) => {
      const domain = getCompanyDomain(c.data.website_url, c.id);
      const logoUrl = getCompanyLogoUrl(c.data.website_url, c.id, 64);
      return {
        ...c,
        domain,
        logoUrl,
      };
    });

    return {
      ...alt,
      related: valid,
    };
  })
);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://www.evstartups.com',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Comparisons',
      item: 'https://www.evstartups.com/alternatives',
    },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'EV Software Comparisons & Alternatives',
  description: 'Side-by-side competitor evaluations and software alternatives for commercial EV fleet charging and telematics.',
  url: 'https://www.evstartups.com/alternatives',
};

const jsonLd = [breadcrumbSchema, collectionSchema];
---

<Layout
  title="EV Software Comparisons & Alternatives | evStartups.com"
  description="Compare leading commercial EV fleet telematics, depot charging systems, and white-label charging platforms."
  jsonLd={jsonLd}
>
  <div class="bg-slate-50 min-h-screen pb-20">
    <!-- Clean Header -->
    <header class="border-b border-slate-200/80 bg-white py-14 sm:py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-3">
          <a href="/" class="hover:text-slate-900 transition">Home</a>
          <span>/</span>
          <span class="text-slate-900 font-semibold">Comparisons</span>
        </nav>

        <div class="max-w-3xl">
          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl font-['Plus_Jakarta_Sans']">
            Software Comparisons & Alternatives
          </h1>
          <p class="mt-3 text-base text-slate-600 leading-relaxed">
            In-depth comparison guides and competitor evaluations for commercial fleet charging platforms and telematics providers.
          </p>
        </div>
      </div>
    </header>

  <!-- Alternatives Cards Grid -->
  <main class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {alternativesWithCompanies.map((alt) => (
        <a
          href={`/alternatives/${alt.id}`}
          class="group flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-6 shadow-xs hover:border-emerald-500 hover:shadow-md transition-all duration-200"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="uppercase text-[10px] tracking-wider font-semibold text-emerald-600">
                {alt.data.target_keyword}
              </span>
            </div>

            <h2 class="mt-3 text-xl font-bold text-slate-900 group-hover:text-emerald-600 transition font-['Plus_Jakarta_Sans']">
              {alt.data.title}
            </h2>

            <!-- Compared Solutions with Logos -->
            <div class="mt-6 border-t border-slate-100 pt-4">
              <span class="text-xs font-semibold text-slate-700 block mb-2.5">
                Compared in this guide:
              </span>
              <div class="flex flex-wrap gap-2">
                {alt.related.map((comp) => (
                  <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-800 shadow-2xs">
                    <img
                      src={comp.logoUrl}
                      alt={`${comp.data.name} icon`}
                      loading="lazy"
                      decoding="async"
                      width="16"
                      height="16"
                      class="h-4 w-4 object-contain rounded"
                      onerror="this.style.display='none';"
                    />
                    <span>{comp.data.name}</span>
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-8 border-t border-slate-100 pt-4">
            <span class="inline-flex items-center text-xs font-semibold text-emerald-600 group-hover:text-emerald-700 transition">
              Read Comparison Guide &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
  </div>
</Layout>
